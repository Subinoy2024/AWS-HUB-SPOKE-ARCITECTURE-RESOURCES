        <mxCell id="fact2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b style=&quot;font-size:26px&quot;&gt;4&lt;/b&gt;&lt;br&gt;&lt;b&gt;Firewall endpoints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5C6875&quot;&gt;one per AZ &amp;#8212; all active at once&lt;/span&gt;" vertex="1">
