        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#232F3E;" value="AWS hub and spoke network &amp;#8212; centralised ingress, egress and east-west inspection" vertex="1">
          <mxGeometry height="32" width="1600" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5C6875;" value="30 spoke accounts &amp;#183; one transit gateway &amp;#183; every packet in, out and sideways crosses a Network Firewall&amp;#160;&amp;#160;&amp;#8226;&amp;#160;&amp;#160; &lt;b style=&quot;color:#01A88D&quot;&gt;teal = coming IN (I1&amp;#8594;I6)&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#ED7100&quot;&gt;orange = going OUT (E1&amp;#8594;E6)&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#E7157B&quot;&gt;pink = east-west, spoke to spoke&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#527FFF&quot;&gt;blue = inside the spoke&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#7AA116&quot;&gt;green = to AWS, no firewall&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#5C6875&quot;&gt;grey = hybrid&lt;/b&gt; &amp;#160;&amp;#8226;&amp;#160; &lt;b style=&quot;color:#37475A&quot;&gt;slate = deployment, not traffic&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="2600" x="50" y="54" as="geometry" />
        </mxCell>
        <mxCell id="dep_h" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF1F5;strokeColor=#37475A;strokeWidth=2;dashed=0;fontSize=13;fontColor=#37475A;align=center;verticalAlign=middle;arcSize=8;" value="DEPLOYMENT&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;how this gets built&lt;/span&gt;" vertex="1">
          <mxGeometry height="46" width="300" x="50" y="92" as="geometry" />
        </mxCell>
        <mxCell id="dep0" parent="1" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#FFFFFF;strokeColor=#37475A;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;" value="&lt;b&gt;git push&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5C6875&quot;&gt;feature branch, one module per PR&lt;/span&gt;" vertex="1">
          <mxGeometry height="46" width="424" x="370" y="92" as="geometry" />
