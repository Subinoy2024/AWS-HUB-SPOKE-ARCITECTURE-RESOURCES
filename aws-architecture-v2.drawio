        <mxCell id="e_igw_net_b" edge="1" parent="1" source="insp_b_igw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#ED7100;strokeWidth=3;dashed=0;dashPattern=8 6;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;flowAnimation=1;" target="internet" value="">
