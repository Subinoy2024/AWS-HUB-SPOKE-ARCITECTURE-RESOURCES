        <mxCell id="e_ew_return" edge="1" parent="1" source="insp_a_fw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#E7157B;strokeWidth=3;dashed=1;dashPattern=8 6;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontStyle=1;fontColor=#E7157B;labelBackgroundColor=#FFFFFF;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="insp_a_att" value="east-west: 10.0.0.0/8 &amp;#8594; back to the TGW, NOT to NAT">
