        <mxCell id="dep_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#5C6875;" value="GitHub OIDC, no static keys anywhere &amp;#183; a brand-new spoke is onboarded by Step Functions: IPAM allocates the /16 &amp;#8594; TGW attachment created &amp;#8594; routes propagate &amp;#8594; no human edits a route table, ever" vertex="1">
          <mxGeometry height="16" width="2860" x="50" y="140" as="geometry" />
