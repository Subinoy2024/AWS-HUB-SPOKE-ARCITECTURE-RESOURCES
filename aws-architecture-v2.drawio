  <diagram id="arch" name="AWS hub and spoke with central inspection">
    <mxGraphModel dx="3404" dy="1306" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2960" pageHeight="3900" background="#FFFFFF" math="0" shadow="0">
